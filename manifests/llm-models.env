# Every model id the cluster's apps use, defined once. kustomization.yaml generates
# an llm-models ConfigMap from this file in each namespace that has consumers
# (ssint-main-ai, ssint-main-crawl, ssint-main-voice); pods read keys with
# configMapKeyRef, and Hermes expands ${KEY} in its config from those env vars.
# Changing a model is an edit here only. The ConfigMap name is stable, so pods do
# not roll on an edit: restart each consumer afterwards (bump
# simplesalt.company/restart-epoch on hermes-agent; rollout restart gbrain,
# hermes-proxy, hindsight and grammar; the crawler picks it up on its next run).
#
# REASONING_MODEL: chat, agent turns, reflection, background reasoning.
# BULK_MODEL: extraction, memory retention, query expansion, side calls.
# gbrain reads the GBRAIN_* openrouter:<id> form; :floor routes to the cheapest
# provider. Keep each GBRAIN_* value equal to its bare id plus that wrapping.
REASONING_MODEL=minimax/minimax-m3.1-flash
BULK_MODEL=openai/gpt-oss-120b
GBRAIN_REASONING_MODEL=openrouter:minimax/minimax-m3.1-flash:floor
GBRAIN_BULK_MODEL=openrouter:openai/gpt-oss-120b:floor
# Image reading (Hermes vision, with fallback). Hermes's approval check also uses
# VISION_FALLBACK_MODEL today.
VISION_MODEL=google/gemini-3.8-flash
VISION_FALLBACK_MODEL=qwen/qwen3-vl-235b-a22b-instruct
# Grammar fixer (ssint-main-voice); comma-separated fallbacks.
GRAMMAR_MODEL=google/gemini-2.5-flash-lite
GRAMMAR_FALLBACK_MODELS=google/gemma-4-26b-a4b-it
# gbrain provider:model form. Changing the embedding model needs a re-embed
# migration (see gbrain-align-embedding-width), not just a restart.
EMBEDDING_MODEL=openai:text-embedding-3-small
RERANKER_MODEL=voyage:rerank-2.5
