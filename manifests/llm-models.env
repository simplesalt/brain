# Every model id the cluster's apps use, defined once. kustomization.yaml generates
# an llm-models ConfigMap from this file in each namespace that has consumers
# (ssint-main-ai, ssint-main-crawl, ssint-main-voice); pods read keys with
# configMapKeyRef, and Hermes expands ${KEY} in its config from those env vars.
# Changing a key is an edit here only. The ConfigMap name is stable, so pods do
# not roll on an edit: restart each consumer afterwards (bump
# simplesalt.company/restart-epoch on hermes-agent; rollout restart gbrain,
# hermes-proxy, hindsight and grammar; the crawler picks it up on its next run).
#
# Four roles, each an OpenRouter preset of the same name:
#   LIVE_REASONING: a person is waiting and the work needs thinking (Hermes chat and agent
#                   turns, Hindsight reflection).
#   LIVE_DUMB:      a person is waiting and the work is simple (grammar fixes, Hermes
#                   approval checks, gbrain query expansion, hermes-proxy side calls).
#   SLOW_REASONING: nobody is waiting and the work needs thinking (gbrain background
#                   reasoning, the crawler's analysis).
#   SLOW_DUMB:      nobody is waiting and the work is simple, in bulk (extraction, memory
#                   retention, crawler bulk passes).
# Model and provider choice, speed vs price, reasoning level and privacy live in the preset
# on OpenRouter, not here. Apps must not send provider or reasoning settings, because
# request settings override a preset's. Hermes's model.context_length (hermes-config.yaml)
# must match the live-reasoning preset's model: Hermes cannot look up a preset's window.
# gbrain reads the GBRAIN_* openrouter:<id> form; keep each equal to its bare key plus that wrapping.
LIVE_REASONING_MODEL=@preset/live-reasoning
LIVE_DUMB_MODEL=@preset/live-dumb
SLOW_REASONING_MODEL=@preset/slow-reasoning
SLOW_DUMB_MODEL=@preset/slow-dumb
GBRAIN_LIVE_DUMB_MODEL=openrouter:@preset/live-dumb
GBRAIN_SLOW_REASONING_MODEL=openrouter:@preset/slow-reasoning
GBRAIN_SLOW_DUMB_MODEL=openrouter:@preset/slow-dumb
# Image reading (Hermes vision); no backup model.
VISION_MODEL=google/gemini-3.8-flash
# gbrain provider:model form. Changing the embedding model needs a re-embed
# migration (see gbrain-align-embedding-width), not just a restart.
EMBEDDING_MODEL=openai:text-embedding-3-small
RERANKER_MODEL=voyage:rerank-2.5
