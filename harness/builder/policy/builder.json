{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "mcp__flux__patch_kubernetes_resource",
      "mcp__efforts__effort_create",
      "mcp__efforts__effort_select",
      "mcp__efforts__effort_update",
      "mcp__efforts__effort_release",
      "mcp__efforts__effort_depend"
    ],
    "blockReadsOutsideWorkingDirectories": true,
    "blockWritesOutsideWorkingDirectories": true
  },
  "model": "sonnet",
  "agent": "builder",
  "autoCompactEnabled": false,
  "env": {
    "DISABLE_AUTO_COMPACT": "1"
  },
  "allowManagedHooksOnly": true,
  "deniedMcpServers": [
    { "serverName": "Claude_Code_Remote" },
    { "serverName": "github" },
    { "serverName": "Notion" },
    { "serverName": "claude.ai Notion" }
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/etc/claude-code/scripts/session-shell-env.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/etc/claude-code/scripts/preload-mcp-skills.py",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/etc/claude-code/scripts/context-handoff.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/etc/claude-code/scripts/require-own-repo-commit.sh"
          },
          {
            "type": "command",
            "command": "/etc/claude-code/scripts/require-no-sed-awk.sh"
          },
          {
            "type": "command",
            "command": "/etc/claude-code/scripts/strip-comments-precommit.py"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "/etc/claude-code/scripts/record-to-stdout.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/etc/claude-code/scripts/context-handoff.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/etc/claude-code/scripts/gitops-push-flux-check.sh",
            "asyncRewake": true,
            "timeout": 180,
            "statusMessage": "git push complete — waiting 2 min for gitops reconcile before checking flux status"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/etc/claude-code/scripts/subagent-tools-only.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/etc/claude-code/scripts/git-resilience-flush.sh"
          }
        ]
      }
    ]
  },
  "alwaysThinkingEnabled": true,
  "autoMemoryEnabled": false,
  "theme": "light",
  "effortLevel": "high",
  "syncClaudeAiSkills": false
}
